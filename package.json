{
  "name": "background-job-scheduler",
  "version": "1.0.0",
  "description": "Background job scheduler with heap-based priority queue, DAG workflows, and DLQ",
  "scripts": {
    "build": "rimraf dist tsconfig.build.tsbuildinfo && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "nest start --entryFile worker.main --watch",
    "start:worker:prod": "node dist/worker.main",
    "benchmark": "npx ts-node -r tsconfig-paths/register src/queue/benchmark.ts",
    "migration:run": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/database/typeorm.config.ts",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.22",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
