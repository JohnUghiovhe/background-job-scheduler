# Local development — uses docker-compose services
NODE_ENV=development
PORT=3000

# Redis (local: docker-compose redis-dev on port 6379)
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# PostgreSQL (local: docker-compose postgres-dev on port 5432)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/job_scheduler_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_scheduler_dev
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# Scheduler tuning
STARVATION_THRESHOLD_MS=60000
DLQ_ALERT_THRESHOLD=10
WORKER_POLL_MS=500
JOB_LOCK_TTL_SEC=300

# Production: copy values to .env.production (Supabase + Upstash)
# NODE_ENV=production loads .env.production automatically
