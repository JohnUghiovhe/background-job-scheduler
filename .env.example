# ─────────────────────────────────────────────────────────────
# Backend Environment Variables
# Copy this file to .env (development) or .env.production (production)
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development                     # development | production
PORT=3000                                # NestJS HTTP port (Nginx reverse-proxies to this)
CORS_ORIGIN=*                            # Allowed origin(s). Comma-separated for multiple:
                                         #   https://jobs.example.com,https://admin.example.com
                                         # Use * in development only.

# ─── Redis (primary database & queue) ───────────────────────
# Option A: Full URL
REDIS_URL=redis://localhost:6379

# Option B: Individual components (used if REDIS_URL is unset)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Scheduler Tuning ───────────────────────────────────────
STARVATION_THRESHOLD_MS=60000            # Priority boost kicks in after this many ms waiting
DLQ_ALERT_THRESHOLD=10                   # Email alert sent when DLQ reaches this many jobs
WORKER_POLL_MS=500                       # Worker poll interval (ms)
JOB_LOCK_TTL_SEC=300                     # Redis lock TTL for in-flight jobs (seconds)
