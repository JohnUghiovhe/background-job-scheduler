# Frontend Environment Variables (Vite)
# Copy to .env for development or .env.production for production.
# Only VITE_* variables are exposed to the browser bundle.

# API base URL the browser uses to reach the NestJS backend.
# Dev: Vite proxy rewrites /api to localhost:3000.
# Prod: Nginx reverse-proxies /api to localhost:3000.
# Custom: use a full URL, such as https://api.jobs.example.com.
VITE_API_BASE_URL=/api

# Optional public UI URL for deployment notes or future client features.
# VITE_APP_URL=https://jobs.example.com
