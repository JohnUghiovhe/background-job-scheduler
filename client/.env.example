# ─────────────────────────────────────────────────────────────
# Frontend Environment Variables (Vite)
# Copy to .env or .env.production
# Only VITE_* prefixed vars are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────

# API base URL the browser uses to reach the NestJS backend.
# Dev:     Vite proxy rewrites /api → localhost:3000
# Prod:    Nginx reverse-proxies /api → localhost:3000
# Custom:  https://api.jobs.example.com (different domain)
VITE_API_BASE_URL=/api

# Your public domain (used by the browser, not by the build)
# VITE_APP_URL=https://jobs.example.com
